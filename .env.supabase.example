# Copy connection values from Supabase Dashboard > Project Settings > Database > Connect.
# Keep real credentials only in .env or the deployment platform's secret manager.

# Runtime transaction pooler used by Next.js and Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection used by Prisma migrations; do not add pgbouncer=true.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
