generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model StudioImage {
  id        String   @id @default(cuid())
  data      Bytes
  createdAt DateTime @default(now())
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ComboDraft {
  id          String   @id @default(cuid())
  name        String
  description String
  rationale   String
  style       String
  price       Int
  image       String
  itemsJson   String
  engine      String
  productId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String         @id
  userId    String?        @unique
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime       @default(now())
  cart      CartItem[]
  orders    Order[]
  wishlist  WishlistItem[]
  wardrobe  WardrobeItem[]
  outfits   Outfit[]

  @@index([expiresAt])
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  name             String
  role             String               @default("CUSTOMER")
  passwordHash     String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  session          Session?
  authSessions     AuthSession[]
  resetTokens      PasswordResetToken[]
  wardrobeProducts UserWardrobe[]

  @@index([role])
}

model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  brand               String
  category            String
  subcategory         String?
  description         String
  material            String
  care                String
  style               String
  pattern             String?
  fit                 String?
  season              Json             @default("[]")
  occasion            Json             @default("[]")
  formality           Int?
  price               Int
  image               String
  transparentImageUrl String?
  tagBadge            String?
  tags                Json             @default("[]")
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  variants            ProductVariant[]
  sizeGuide           SizeGuideRow[]
  wishlist            WishlistItem[]
  wardrobeUsers       UserWardrobe[]

  @@index([active, category, price])
}

model ProductTaxonomyOption {
  id             String   @id @default(cuid())
  scopeKey       String   @default("GLOBAL")
  kind           String
  groupCode      String
  name           String
  normalizedName String
  aliases        Json     @default("[]")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scopeKey, kind, groupCode, normalizedName])
  @@index([scopeKey, kind, groupCode])
}

model ProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String     @unique
  size      String
  color     String
  colorHex  String
  stock     Int        @default(0)
  cart      CartItem[]

  @@unique([productId, size, color])
}

model SizeGuideRow {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  chestMin  Float?
  chestMax  Float?
  waistMin  Float?
  waistMax  Float?
  hipMin    Float?
  hipMax    Float?

  @@unique([productId, size])
}

model CartItem {
  id        String         @id @default(cuid())
  sessionId String
  session   Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([sessionId, variantId])
}

model Order {
  id             String          @id @default(cuid())
  number         String          @unique
  sessionId      String
  session        Session         @relation(fields: [sessionId], references: [id])
  idempotencyKey String
  requestHash    String
  status         String          @default("PENDING")
  paymentMethod  String          @default("COD")
  paymentStatus  String          @default("UNPAID")
  customerName   String
  phone          String
  address        String
  city           String
  note           String?
  subtotal       Int
  shippingFee    Int
  total          Int
  trackingNumber String?
  carrier        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deliveredAt    DateTime?
  items          OrderItem[]
  events         OrderEvent[]
  returns        ReturnRequest[]

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  variantId String
  name      String
  sku       String
  size      String
  color     String
  image     String
  unitPrice Int
  quantity  Int
  returns   ReturnRequest[]
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  reason      String
  status      String    @default("REQUESTED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
}

model WishlistItem {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId])
}

// Shop-backed wardrobe: one saved product per account, metadata stays in Product.
model UserWardrobe {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model WardrobeItem {
  id         String        @id @default(cuid())
  sessionId  String
  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name       String
  searchName String        @default("")
  category   String
  color      String
  imageUrl   String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  tags       WardrobeTag[]

  @@index([sessionId, category, createdAt])
  @@index([sessionId, color, createdAt])
}

// A garment can suit several seasons, styles and occasions.
model WardrobeTag {
  itemId String
  item   WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind   String
  value  String

  @@id([itemId, kind, value])
  @@index([kind, value, itemId])
}

model Outfit {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name       String
  productIds String
  createdAt  DateTime @default(now())
}
