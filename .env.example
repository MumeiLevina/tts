# ========================================================
# FITCRAFT PRODUCTION / INTERNET ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase PostgreSQL: runtime transaction pooler and migration session pooler
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Public Production URL (CRITICAL for CSRF / Origin protection on internet)
# Example: https://fitcraft.vn or https://your-app.vercel.app
APP_ORIGIN=http://localhost:3000

# Secret Key for Headless Admin APIs (minimum 32 characters, keep secret!)
ADMIN_API_KEY=

# Optional: Email Service for Password Reset (Resend)
RESEND_API_KEY=
AUTH_FROM_EMAIL=no-reply@fitcraft.vn

# AI Virtual Try-On Provider Configuration
# Supported providers: "fashn" (Fashn.ai), "replicate" (IDM-VTON), or "mock" (for sandbox testing)
TRYON_PROVIDER=
TRYON_API_KEY=
TRYON_API_URL=

# AI Stylist: use mock locally without spending provider credits.
AI_PROVIDER=openai
AI_STYLIST_MOCK=false
OPENAI_API_KEY=
OPENAI_STYLIST_MODEL=gpt-4.1-mini

# Optional future provider; no Gemini adapter is implemented yet.
GEMINI_API_KEY=
