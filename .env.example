# ========================================================
# FITCRAFT ENVIRONMENT CONFIGURATION
# Copy this file to .env and replace placeholders locally.
# Never commit real credentials.
# ========================================================

# PostgreSQL runtime connection. Use the Supabase pooler in production.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"

# Direct PostgreSQL connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"

# Exact public origin, without a trailing slash.
APP_ORIGIN="http://localhost:3000"

# Headless admin API key. Generate a random value with at least 32 characters.
ADMIN_API_KEY=

# Optional password-reset email service.
RESEND_API_KEY=
AUTH_FROM_EMAIL="FitCraft <noreply@example.com>"

# Virtual try-on provider: fashn, replicate, or mock.
TRYON_PROVIDER="mock"
TRYON_API_KEY=
TRYON_API_URL=

# AI stylist. Mock mode works locally without provider credits.
AI_PROVIDER="mock"
AI_STYLIST_MOCK="true"
OPENAI_API_KEY=
OPENAI_STYLIST_MODEL="gpt-4.1-mini"

# Reserved for a future provider; no Gemini adapter is implemented yet.
GEMINI_API_KEY=
